// دالة تحميل السور لقائمة الاختيار
function populateSurahSelect() {
    const select = document.getElementById('surahSelect');
    if (!select) return;
    
    QURAN_DATA.surahs.forEach(surah => {
        const option = document.createElement('option');
        option.value = surah.id;
        option.textContent = `${surah.id}. ${surah.name} (${surah.ayahs} آيات)`;
        select.appendChild(option);
    });
}

// دالة تحميل آيات السورة
async function loadSurah(surahId) {
    if (!surahId) return;
    
    const versesContainer = document.getElementById('versesContainer');
    versesContainer.innerHTML = '<div class="loading"><i class="fas fa-spinner fa-spin"></i> جاري تحميل السورة...</div>';
    
    try {
        // استخدام API حقيقي - AlQuran Cloud API
        const response = await fetch(`https://api.alquran.cloud/v1/surah/${surahId}`);
        const data = await response.json();
        
        if (data.code === 200) {
            const surah = data.data;
            displaySurah(surah);
        }
    } catch (error) {
        // في حالة فشل API، استخدم البيانات المحلية
        loadLocalSurah(surahId);
    }
}

// عرض السورة في المصحف
function displaySurah(surah) {
    const versesContainer = document.getElementById('versesContainer');
    const surahName = document.getElementById('surahName');
    const surahInfo = document.getElementById('surahInfo');
    
    surahName.textContent = surah.name;
    surahInfo.textContent = `${surah.revelationType} - ${surah.numberOfAyahs} آيات`;
    
    let html = '';
    surah.ayahs.forEach((ayah, index) => {
        const ayahNumber = index + 1;
        const ayahText = ayah.text;
        
        // إضافة رقم الآية كدائرة
        html += `
            <div class="verse-item" id="verse-${surah.number}-${ayahNumber}">
                <span class="verse-number-circle">${ayahNumber}</span>
                <span class="verse-text">${ayahText}</span>
            </div>
        `;
    });
    
    versesContainer.innerHTML = html;
}

