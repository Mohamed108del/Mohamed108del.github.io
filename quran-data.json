// دالة تغيير الخط
function changeQuranFont(fontType) {
    const verses = document.querySelectorAll('.verse-text');
    const fontFamily = QURAN_DATA.fonts[fontType]?.fontFamily || 'Amiri';
    
    verses.forEach(verse => {
        verse.style.fontFamily = fontFamily;
    });
}

// تشغيل الصوت
let currentAudio = null;

function playAyahAudio(surah, ayah) {
    if (currentAudio) {
        currentAudio.pause();
    }
    
    const reciter = document.getElementById('reciterSelect').value;
    const audioUrl = `https://cdn.islamic.network/quran/audio/${getReciterCode(reciter)}/${surah}${ayah}.mp3`;
    
    currentAudio = new Audio(audioUrl);
    currentAudio.play();
    
    // تحديث مشغل الصوت
    document.getElementById('playingSurah').textContent = `سورة ${getSurahName(surah)} - الآية ${ayah}`;
    document.getElementById('playPauseIcon').className = 'fas fa-pause';
}

// التهيئة عند تحميل الصفحة
document.addEventListener('DOMContentLoaded', function() {
    populateSurahSelect();
    loadSurah(1); // تحميل الفاتحة افتراضياً
    updateDateTime();
    setInterval(updateDateTime, 1000);
});

// تحديث الوقت والتاريخ
function updateDateTime() {
    const now = new Date();
    const timeElement = document.getElementById('currentTime');
    const dateElement = document.getElementById('currentDate');
    
    if (timeElement) {
        timeElement.textContent = now.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
    }
    
    if (dateElement) {
        dateElement.textContent = now.toLocaleDateString('ar-EG', { 
            weekday: 'long', 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
        });
    }
}

// دوال مساعدة أخرى
function getReciterCode(reciter) {
    const codes = {
        'abdulbasit': 'abdulbasit_murattal',
        'husary': 'husary_muallim',
        'minshawi': 'minshawi_murattal',
        'afasy': 'afasy',
        'sudais': 'sudais'
    };
    return codes[reciter] || 'abdulbasit_murattal';
}

function getSurahName(id) {
    const surah = QURAN_DATA.surahs.find(s => s.id == id);
    return surah ? surah.name : '';
}